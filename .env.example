# Aether configuration -- copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# Optional: ANU Quantum RNG API key (https://quantumnumbers.anu.edu.au/).
# If left unset, Aether skips the quantum source and runs on the chaotic
# core + OS CSPRNG entropy. It does NOT fail without a key.
ANU_QRNG_API_KEY=

# Optional: passphrase used to encrypt the local key vault (see utility/vault.py).
# If unset, the vault will prompt for one interactively.
AETHER_VAULT_PASSPHRASE=
